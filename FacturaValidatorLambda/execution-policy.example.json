{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeFriendQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:us-east-1:563105261074:facturas-pendientes"
    },
    {
      "Sid": "ReadPendingInvoicePdfs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::invoices-inovacar/pendientes/*"
    },
    {
      "Sid": "CheckInvoiceArchiveKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::invoices-inovacar",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "pendientes/*",
            "aprobadas/*",
            "rechazadas/*"
          ]
        }
      }
    },
    {
      "Sid": "ArchiveInvoicePdfs",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::invoices-inovacar/aprobadas/*",
        "arn:aws:s3:::invoices-inovacar/rechazadas/*"
      ]
    },
    {
      "Sid": "RemoveProcessedInvoiceFromPending",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::invoices-inovacar/pendientes/*"
    },
    {
      "Sid": "ReadSupabaseSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "REPLACE_WITH_SUPABASE_SECRET_ARN"
    },
    {
      "Sid": "ReadTelegramBotTokenSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:290597578821:secret:TELEGRAM_TOKEN-xZI1DB"
    },
    {
      "Sid": "PublishInvoiceNotification",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "REPLACE_WITH_SNS_TOPIC_ARN"
    },
    {
      "Sid": "WriteLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:290597578821:log-group:/aws/lambda/inova-validar-facturas:*"
    }
  ]
}
