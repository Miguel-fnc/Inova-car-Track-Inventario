#!/bin/bash
set -euxo pipefail

dnf install -y nginx awscli-2 cronie
mkdir -p /usr/share/nginx/html

cat > /etc/nginx/conf.d/inova.conf <<'NGINX'
server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}
NGINX

rm -f /etc/nginx/conf.d/default.conf
nginx -t
systemctl enable --now nginx
systemctl enable --now crond

# Nginx responde aunque falle la descarga; revisa cloud-init-output.log si no aparece el sitio.
aws s3 sync "s3://${bucket_name}/site/" /usr/share/nginx/html/ --delete --region "${aws_region}" || echo "Initial S3 sync failed; check /var/log/cloud-init-output.log"

cat > /usr/local/bin/inova-sync-site.sh <<'SYNC'
#!/bin/bash
set -euo pipefail
aws s3 sync "s3://${bucket_name}/site/" /usr/share/nginx/html/ --delete --region "${aws_region}"
SYNC
chmod 0755 /usr/local/bin/inova-sync-site.sh

cat > /etc/cron.d/inova-site-sync <<'CRON'
* * * * * root /usr/local/bin/inova-sync-site.sh >> /var/log/inova-site-sync.log 2>&1
CRON
chmod 0644 /etc/cron.d/inova-site-sync
systemctl restart crond

